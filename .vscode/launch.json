{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wokwi GDB (ESP32 Zephyr)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/xtensa-espressif_esp32_zephyr-elf/bin/xtensa-espressif_esp32_zephyr-elf-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333"
    }
  ]
}
